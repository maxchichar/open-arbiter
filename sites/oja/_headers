# Cloudflare Pages headers for the open agentic web (spec 3.3, 3.4).
/agent-manifest.json
  Access-Control-Allow-Origin: *
/oja_market.network.json
  Access-Control-Allow-Origin: *
/links.json
  Access-Control-Allow-Origin: *
/agent-mcp.json
  Access-Control-Allow-Origin: *
/.well-known/*
  Access-Control-Allow-Origin: *
/runtime/sandbox-worker.js
  Content-Security-Policy: default-src 'none'; script-src blob:; connect-src 'none'; worker-src 'none'

# Page CSP (P0.8). Scripts only from this origin: no inline script, no eval. Styles: this site's
# stylesheets plus the runtime's one injected <style> by hash (tests/csp.test.mjs recomputes it from
# runtime/ui.js and fails if the runtime changes); inline style attributes are allowed because the
# runtime renders some. connect-src: this site, the arbiter (DEFAULT_ARBITER_URL in js/config.js),
# the LLM providers offered in the assistant's settings, and https://otari.ai, where Connect with
# Otari exchanges its sign-in code for a key (openrouter.ai, already a provider, does the same for
# Connect with OpenRouter); a custom Provider URL is blocked and js/provider-guard.js says so in the
# settings panel. Update connect-src when the arbiter URL
# changes; the test checks it. No framing of the pages that hold the Accept buttons.
/
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src-elem 'self' 'sha256-cInCcVTzIwlAW/42yPHZKk4sbZHVNv7RM9LUQR14NT8='; style-src-attr 'unsafe-inline'; img-src 'self'; connect-src 'self' http://localhost:8787 https://api.otari.ai https://eu.api.otari.ai https://generativelanguage.googleapis.com https://api.groq.com https://openrouter.ai https://otari.ai https://api.openai.com https://api.anthropic.com; worker-src 'self'; frame-src 'none'; form-action 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'
