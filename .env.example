# Copy this file to .env for local testing.
# On Render, set these in the dashboard instead (Environment tab) — never commit real secrets.

DISCORD_BOT_TOKEN=your-bot-token-here

# NVIDIA NIM — free, OpenAI-compatible LLM API. Get one at build.nvidia.com
# (Settings -> API Keys). Requires phone verification, no credit card.
NVIDIA_API_KEY=nvapi-your-key-here
NIM_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1

# Where the SQLite database file lives. On Render, point this at your
# mounted disk path (see render.yaml) so data survives restarts/deploys.
DB_PATH=away_bot.db
